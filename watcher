local Players = game:GetService("Players")
local pg = Players.LocalPlayer:WaitForChild("PlayerGui")

local function say(msg)
    local ok, tf = pcall(function() return game:GetService("TextChatService") end)
    if ok and tf and tf.ChatVersion == Enum.ChatVersion.TextChatService then
        local ch = tf:FindFirstChild("TextChannels"):FindFirstChild("RBXGeneral")
        if ch then ch:DisplaySystemMessage(msg) end
    end
end

say("[1] alive")
task.wait(4)
say("[2] survived 4s")

local hits = {}
for _, d in ipairs(game:GetDescendants()) do
    if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") or d:IsA("UnreliableRemoteEvent") then
        local n = d:GetFullName():lower()
        if n:find("rebirth") or n:find("trade") or n:find("prestige") then
            table.insert(hits, d:GetFullName())
        end
    end
end
for _, h in ipairs(hits) do say("R: " .. h) end

task.wait(4)
say("[4] survived 8s")

for _, d in ipairs(pg:GetDescendants()) do
    if d:IsA("TextButton") then
        local c = (d.Text .. " " .. d.Name):lower()
        if c:find("rebirth") or c:find("trade") then
            say("B: " .. d:GetFullName() .. " | " .. d.Text)
        end
    end
end

task.wait(4)
say("[6] done")
